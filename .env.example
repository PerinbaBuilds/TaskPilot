# ─────────────────────────────────────────────────────────────
# TaskPilot — environment variables
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
# All variables are OPTIONAL — the app runs without any of them.
# ─────────────────────────────────────────────────────────────

# Groq API key — enables LLM-generated explanations in the "Explainable AI" tab.
# Get a free key at https://console.groq.com/keys
# If left blank, TaskPilot falls back to built-in rule-based explanations.
GROQ_API_KEY=

# Port the server listens on (defaults to 8000 locally).
# On most hosts (Render, Railway, Heroku) this is injected automatically —
# leave it unset there.
PORT=8000
